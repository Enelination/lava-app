# Copy to .env and fill in for local development (optional).
# Render injects these automatically — see render.yaml.
SUPABASE_URL=
# Server-side access key. Prefer the service_role key; the anon key is a dev fallback only.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# REQUIRED in production — the app refuses to boot without it when NODE_ENV=production.
JWT_SECRET=
CLAUDE_API_KEY=
# Optional — enables error tracking.
SENTRY_DSN=
# Comma-separated list of allowed CORS origins.
APP_ORIGINS=
